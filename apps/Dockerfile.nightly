FROM europe-docker.pkg.dev/da-images/public/docker/da-base-image:node-1.0.17 AS node
FROM nginx:1.31.8-alpine-slim AS nginx
FROM ghcr.io/pnpm/pnpm:12.15.0 AS pnpm

FROM pnpm AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl git python3 make g++ default-jre-headless \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /source
COPY --from=wallet / .
# Avoid querying optional musl builds from the unofficial mirror on Debian.
RUN pnpm config set --global --json nodeDownloadMirrors '{"release":"https://nodejs.org/dist/"}' \
    && pnpm runtime set node "$(cat .nvmrc)" --global
ENV CI=true NX_DAEMON=false NX_TUI=false
RUN pnpm install --frozen-lockfile
RUN pnpm generate:all
RUN pnpm exec nx run-many -t build \
    -p @canton-network/wallet-gateway-remote @canton-network/example-portfolio

RUN pnpm script:flat-pack wallet-gateway/remote /gateway

FROM node AS gateway-deploy
WORKDIR /gateway
COPY --from=build /gateway/ ./
RUN npm install --omit=dev

FROM node AS wallet-gateway
WORKDIR /app
COPY --from=gateway-deploy --chown=nonroot:nonroot /gateway/node_modules ./node_modules
ENTRYPOINT ["./node_modules/.bin/wallet-gateway-remote"]

FROM nginx AS splice-portfolio
RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /source/examples/portfolio/dist/ /usr/share/nginx/html/
COPY apps/splice-portfolio/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
