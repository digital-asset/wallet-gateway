#!/usr/bin/env bash
set -euo pipefail
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)"
repo_root="${script_dir}/.."
app="${1:-}"

if [ -z "${app}" ]; then
  echo "Usage: bump <wallet-gateway|splice-portfolio>"
  exit 1
fi

app_dir="${repo_root}/apps/${app}"
version_file="${app_dir}/VERSION"

if [ ! -f "${version_file}" ]; then
  echo "❌ Error: ${version_file} file not found."
  exit 1
fi

version="$(<"${version_file}")"

echo "🚀 Syncing ${app} to version: ${version}"

echo "📦 Updating NPM package and package-lock.json..."
# Using a subshell ( ) ensures the 'cd' only applies to this specific block
(
  cd "${app_dir}"
  package="$(node -p 'Object.keys(require("./package.json").dependencies)[0]')"
  npm install "${package}@${version}" --save-exact
)
echo "⚙️ Running helm-gen to update schema..."
"${script_dir}/helm-gen" "${app}"

echo ""
echo "✅ Sync complete! Ready to commit."
